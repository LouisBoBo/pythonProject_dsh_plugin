# 服务器远端审码环境变量（勿提交真实密钥到 git；部署后在服务器上改）
# 路径: /www/wwwroot/dsh-remote-review/server.env

WORKBUDDY_ENGINE=http://127.0.0.1:8091
REMOTE_REVIEW_LISTEN=127.0.0.1
REMOTE_REVIEW_PORT=18787
REMOTE_REVIEW_REQUIRE_SECRET=1

# 与 GitHub/GitLab Webhook Secret、设置页「Webhook 密钥」保持一致
REMOTE_REVIEW_SECRET=please-change-me

# 飞书（也可在设置页保存到服务器 ~/.zhongruan/remote-review/config.json）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_FOLDER_TOKEN=

# 说明：本机 8000 是其它业务（如 GraphRAG），不要填；
# 审码引擎在 DSH-ZR-WorkBuddy → 8091（或 DSH-WorkBuddy → 8095）
# 还需在对应引擎「配置中心 → 审码车道」开启
