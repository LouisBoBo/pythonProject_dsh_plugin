{
  "name": "@zhongruan/dsh-automations",
  "version": "0.1.30",
  "description": "DSH 自动化任务：模板或自定义指令定时执行只读汇总，可选推企微、写入飞书/语雀文档",
  "dshMarket": {
    "zh": "自动化任务：模板一键建或自定义指令，定时执行只读汇总，可选推企微、每天新建飞书或语雀文档",
    "en": "Scheduled automations: templates or custom prompts, read-only summaries, optional WeCom push and daily Feishu/Yuque docs"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc && cp src/client.js lib/client.js && cp src/chart_render.py lib/chart_render.py",
    "self-test": "node lib/self-test.js"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://175.178.238.31/dsh-plugins/npm/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
