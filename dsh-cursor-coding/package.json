{
  "name": "@zhongruan/dsh-cursor-coding",
  "version": "0.6.36",
  "description": "主流程冻结；会话认 DSH、执行认本机 Job（见 docs/架构与选型/DSH会话与记忆分层.md）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc && cp src/client.js lib/client.js && mkdir -p lib/ui && cp src/ui/console.html lib/ui/console.html",
    "self-test": "node lib/self-test.js",
    "verify:clarify": "node lib/verify-clarify-gate.js",
    "verify:wait": "node lib/verify-wait-fast.js",
    "verify:a": "node lib/verify-real-a.js",
    "verify:bc": "node lib/verify-real-bc.js",
    "ui": "node lib/serve-ui.js"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://175.178.238.31/dsh-plugins/npm/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
