{
  "schemaVersion": 1,
  "updatedAt": "2026-11-02",
  "description": "独立 DSH 插件：不依赖 WorkBuddy 引擎；写码步骤依赖 @zhongruan/dsh-cursor-chat。",
  "components": {
    "dsh_runtime": {
      "id": "dsh_runtime",
      "label": "DSH 运行时（cordis + dsh-tools）",
      "packages": ["@deepseek-ai/cordis", "@deepseek-ai/dsh-tools"]
    },
    "plugin_dev_pipeline": {
      "id": "plugin_dev_pipeline",
      "label": "一体化流水线 @zhongruan/dsh-dev-pipeline",
      "package": "@zhongruan/dsh-dev-pipeline"
    },
    "plugin_cursor_chat": {
      "id": "plugin_cursor_chat",
      "label": "对话写码 @zhongruan/dsh-cursor-chat",
      "package": "@zhongruan/dsh-cursor-chat"
    }
  },
  "declarations": [
    {
      "from": "plugin_dev_pipeline",
      "pluginVersionRange": ">=0.1.0 <1.0.0",
      "requires": {
        "dsh_runtime.cordis": ">=4.0.2 <5.0.0",
        "dsh_runtime.dsh_tools": ">=0.1.1-rc.2 <0.3.0",
        "plugin_cursor_chat": ">=0.1.0 <1.0.0"
      },
      "notes": "写码步骤调用 cursor-chat 的 :18791 HTTP；未安装时第 5 步会明确失败，不影响前四步。"
    }
  ]
}
