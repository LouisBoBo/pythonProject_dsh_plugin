{
  "name": "@zhongruan/dsh-llm-meter",
  "version": "0.1.3",
  "description": "本机旁路 LLM 计量（非用量产品入口；用量统计请用 dsh-key-quota）：llm/stream 出口记 token 分项到 events.jsonl",
  "dshMarket": {
    "zh": "本机旁路计量（非用量页）：记 token 分项到本机 jsonl；用量统计/限额请用 key-quota",
    "en": "Local llm/stream meter only (not the usage UI); use dsh-key-quota for stats & quota"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "token",
    "usage"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.mjs",
    "self-test": "tsc && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://175.178.238.31/dsh-plugins/npm/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
