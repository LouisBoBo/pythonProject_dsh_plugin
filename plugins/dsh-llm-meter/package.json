{
  "name": "@zhongruan/dsh-llm-meter",
  "version": "0.1.1",
  "description": "DSH LLM 用量计量：在 llm/stream 出口记录真实 token 分项，落盘本机 events.jsonl",
  "dshMarket": {
    "zh": "LLM 用量计量：记录每次模型调用的真实 token 分项，供本机观测（不等于官网账单）",
    "en": "LLM usage meter: record real per-call token breakdown locally (not the provider console bill)"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "token",
    "usage"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.mjs",
    "self-test": "tsc && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://175.178.238.31/dsh-plugins/npm/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
