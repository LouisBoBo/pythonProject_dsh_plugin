{
  "name": "@zhongruan/dsh-cursor-chat",
  "version": "0.1.1",
  "description": "对话式多轮写码：用户原话+截图进 Cursor 多模态，确认后改盘，续改优先 Agent.resume",
  "dshMarket": {
    "zh": "对话写码：像跟 Cursor 聊（可贴图），确认后改代码，同会话可多轮续改",
    "en": "Chat coding: talk like Cursor with images, confirm then edit, multi-turn resume"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compat-matrix.json"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');fs.mkdirSync('lib/ui',{recursive:true});fs.copyFileSync('src/client.js','lib/client.js');fs.copyFileSync('src/ui/console.html','lib/ui/console.html')\"",
    "self-test": "node lib/self-test.js",
    "verify:wait": "node lib/verify-wait-fast.js",
    "verify:a": "node lib/verify-real-a.js",
    "verify:bc": "node lib/verify-real-bc.js",
    "ui": "node lib/serve-ui.js"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://175.178.238.31/dsh-plugins/npm/"
  },
  "zhongruanCompat": {
    "component": "plugin_cursor_chat",
    "matrix": "./compat-matrix.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
