{
  "name": "@zhongruan/dsh-key-quota",
  "version": "0.1.53",
  "description": "用量统计主插件：按平台账号分配 DeepSeek Key，侧栏看用量并设上限",
  "dshMarket": {
    "zh": "用量统计（Key 限额）：侧栏看用量；按账号分配 Key，超额后停止调用（勿与 llm-meter 混淆）",
    "en": "Usage stats & per-key quota (primary); not the frozen llm-meter sidecar"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "token", "quota"],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/client.js','lib/client.js')\"",
    "test": "tsc && node --test test/*.test.mjs",
    "self-test": "tsc && node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://175.178.238.31/dsh-plugins/npm/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
