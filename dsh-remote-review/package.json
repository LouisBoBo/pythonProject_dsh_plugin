{
  "name": "@zhongruan/dsh-remote-review",
  "version": "0.1.4",
  "description": "DSH 远端审码插件：IDE 提交触发 Webhook，调用现有审码 API，报告写入飞书文档；设置页可填飞书配置",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-remote-review": "./lib/cli.js"
  },
  "files": ["lib", "cordis.patch.yml"],
  "scripts": {
    "build": "tsc && cp src/client.js lib/client.js",
    "start": "node lib/cli.js",
    "self-test": "node lib/self-test.js"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://175.178.238.31/dsh-plugins/npm/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
