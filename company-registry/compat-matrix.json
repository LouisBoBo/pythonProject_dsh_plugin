{
  "schemaVersion": 1,
  "updatedAt": "2026-10-29",
  "description": "宿主与运行时兼容声明。各方按 ranges 互认；未知组件记 soft。",
  "components": {
    "workbuddy": {
      "id": "workbuddy",
      "label": "WorkBuddy / DSH 宿主",
      "detect": ["env:WORKBUDDY_VERSION", "env:DSH_APP_VERSION"]
    },
    "dsh_runtime": {
      "id": "dsh_runtime",
      "label": "DSH 运行时（cordis + dsh-tools）",
      "packages": ["@deepseek-ai/cordis", "@deepseek-ai/dsh-tools"]
    }
  },
  "declarations": [
    {
      "from": "dsh_runtime",
      "requires": {
        "workbuddy": ">=0.0.0"
      },
      "notes": "运行时互认区间（本仓镜像声明）"
    },
    {
      "from": "workbuddy",
      "requires": {
        "dsh_runtime.cordis": ">=4.0.2 <5.0.0"
      },
      "notes": "宿主侧期望；实际以宿主发布清单为准，本仓先挂镜像"
    }
  ]
}
